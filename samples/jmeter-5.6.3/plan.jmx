          <stringProp name="LoopController.loops">5</stringProp>
        </LoopController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="01. Home page" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">long ms = 5 + new Random().nextInt(60);
SampleResult.sleep(ms);
SampleResult.setSuccessful(new Random().nextInt(100) &gt;= 12);
SampleResult.setResponseCodeOK();
SampleResult.setResponseMessage('OK');
return 'ok';</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
